<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewData["Description"] ?? "Academia de Fútbol El Potrero: formación deportiva y humana para niños y jóvenes de 4 a 17 años.")" />
    <title>@ViewData["Title"] · Academia El Potrero</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
        var accion = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index" aria-label="Academia El Potrero, ir al inicio">
                    <span class="brand-mark" aria-hidden="true">EP</span>
                    <span class="brand-text">
                        El Potrero
                        <small>Academia de Fútbol</small>
                    </span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Abrir menú de navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link @(controlador == "Home" && accion == "Index" ? "active" : string.Empty)"
                               asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controlador == "Categorias" ? "active" : string.Empty)"
                               asp-controller="Categorias" asp-action="Index">Categorías</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controlador == "Jugadores" && accion != "Create" ? "active" : string.Empty)"
                               asp-controller="Jugadores" asp-action="Index">Jugadores</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controlador == "Home" && accion == "Nosotros" ? "active" : string.Empty)"
                               asp-controller="Home" asp-action="Nosotros">Nosotros</a>
                        </li>
                    </ul>
                    <a class="btn btn-brand" asp-controller="Jugadores" asp-action="Create">
                        Inscribir jugador
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <a class="brand brand-light text-decoration-none" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark" aria-hidden="true">EP</span>
                        <span class="brand-text">
                            El Potrero
                            <small>Academia de Fútbol</small>
                        </span>
                    </a>
                    <p class="mt-3 mb-0 footer-text">
                        Formamos personas y futbolistas con disciplina, alegría y amor
                        por el juego. Semilleros para niños y jóvenes de 4 a 17 años.
                    </p>
                </div>
                <div class="col-6 col-lg-3">
                    <h2 class="footer-title">Sedes</h2>
                    <ul class="list-unstyled footer-text mb-0">
                        <li>Sede Norte</li>
                        <li>Sede Sur</li>
                        <li>Sede Envigado</li>
                        <li class="mt-3">Lun–Vie · 4:00 a 7:00 p. m.</li>
                        <li>Sábados · 8:00 a 11:00 a. m.</li>
                    </ul>
                </div>
                <div class="col-6 col-lg-4">
                    <h2 class="footer-title">Contacto</h2>
                    <ul class="list-unstyled footer-text mb-0">
                        <li>Medellín, Antioquia</li>
                        <li>Tel. (604) 555 20 26</li>
                        <li>info@elpotrero.co</li>
                        <li class="mt-3">
                            <a class="footer-link" href="https://github.com/juankekesyt-collab/academia-el-potrero-mvc"
                               target="_blank" rel="noopener">Ver repositorio en GitHub ↗</a>
                        </li>
                    </ul>
                </div>
            </div>
            <hr class="footer-divider" />
            <div class="d-flex flex-column flex-md-row justify-content-between gap-2 small">
                <span>© 2026 Academia de Fútbol El Potrero. Todos los derechos reservados.</span>
                <span>Proyecto académico · ASP.NET Core MVC + C#</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
