@model Categoria

<div class="col">
    <article class="card category-card h-100">
        <div class="category-icon" aria-hidden="true">@Model.Icono</div>
        <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                <span class="badge category-badge">@Model.RangoEdad</span>
                <span class="badge category-fee">@Model.Mensualidad.ToString("C0") / mes</span>
            </div>

            <h3 class="h5 category-title">@Model.Nombre</h3>
            <p class="category-description">@Model.Descripcion</p>

            <div class="category-schedule">
                <span aria-hidden="true">🕒</span>
                <span>@Model.Horario</span>
            </div>

            <div class="mt-auto d-flex align-items-center justify-content-between gap-2 pt-3">
                <a class="btn btn-sm btn-outline-brand"
                   asp-controller="Categorias" asp-action="Details" asp-route-id="@Model.Id">Ver categoría</a>
                <a class="btn btn-sm btn-brand"
                   asp-controller="Jugadores" asp-action="Create">Inscribir</a>
            </div>
        </div>
    </article>
</div>
