@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="empty-state">
        <span class="empty-icon" aria-hidden="true">🥅</span>
        <h1 class="h3">El balón se fue por la línea de fondo</h1>
        <p class="mb-4">
            Ocurrió un error inesperado al procesar tu solicitud. Intenta nuevamente
            o vuelve a la página de inicio.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="small text-muted">
                <strong>Identificador de la solicitud:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a class="btn btn-brand" asp-controller="Home" asp-action="Index">Volver al inicio</a>
            <a class="btn btn-outline-secondary" asp-controller="Categorias" asp-action="Index">Ver categorías</a>
        </div>
    </div>
</div>
